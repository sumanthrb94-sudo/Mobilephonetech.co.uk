{
  "name": "lehart-co-uk",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "node scripts/generate-seo-assets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && tsc -p tsconfig.api.json --noEmit",
    "seo": "node scripts/generate-seo-assets.mjs",
    "db:bootstrap": "./scripts/bootstrap-db.sh",
    "e2e": "node e2e/journeys.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "e2e:interactions": "node e2e/interactions.mjs",
    "e2e:admin": "node e2e/admin.mjs",
    "e2e:focus": "node e2e/focus.mjs",
    "seed": "node scripts/seed-firestore.mjs",
    "create-users": "node scripts/create-users.mjs",
    "emulators": "firebase emulators:start --project demo-lehart --only auth,firestore,storage",
    "e2e:csp": "node e2e/csp.mjs",
    "e2e:checkout": "node e2e/checkout.mjs",
    "e2e:parallel": "node e2e/parallel.mjs",
    "audit:security": "node e2e/security-audit.mjs",
    "e2e:api": "node e2e/api-server.mjs",
    "email:preview": "tsx scripts/preview-emails.ts",
    "listmonk:sync": "node scripts/listmonk-sync.mjs",
    "lint:api": "tsc -p tsconfig.api.json --noEmit",
    "pdf:brevo": "node scripts/make-brevo-pdf.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@shopify/storefront-api-client": "^1.0.10",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.0.4",
    "animejs": "^4.5.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^13.10.0",
    "graphql": "^16.13.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.21",
    "firebase-tools": "^15.25.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.5"
  }
}
