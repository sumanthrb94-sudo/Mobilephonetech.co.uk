# Build profile for the local end-to-end suites: `vite build --mode e2e`.
#
# Every value here is a placeholder for the Firebase EMULATOR suite, which
# accepts any api key and any project id and holds no real data. Nothing in
# this file is a credential, which is why it is committed: without it the
# documented test command in docs/ADMIN.md cannot be run from a clean clone,
# and `isFirebaseConfigured` silently falls back to the "unconfigured"
# placeholder project — so the browser and the seed script end up writing to
# two different namespaces and every data assertion fails for the wrong reason.
#
# The project id MUST match e2e/emulator-seed.mjs (demo-lehart). The `demo-`
# prefix is what makes the emulators refuse to reach any real backend.
VITE_FIREBASE_EMULATOR=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

VITE_FIREBASE_PROJECT_ID=demo-lehart
VITE_FIREBASE_API_KEY=emulator-fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-lehart.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-lehart.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:e2e

# Deliberately absent: no PayPal client id. The checkout suite asserts that an
# unconfigured gateway refuses the order rather than appearing to take one.

# On for the suite only. The admin tests assert the shopper's assistant bubble
# never follows staff into the console; with the feature dark the positive
# control matches nothing and that assertion quietly stops testing anything.
# Production keeps it off — it is the only Gemini spend on the live site.
VITE_AI_ASSISTANT=true
