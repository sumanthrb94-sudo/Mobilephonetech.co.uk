# ── Supabase ───────────────────────────────────────────────────
# Get these from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-side only — used by the seed script and server functions.
# Get from: Settings → API → service_role key (keep secret, never use VITE_ prefix)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── AI Tech Advisor ────────────────────────────────────────────
# Server-side only, never use VITE_ prefix
GEMINI_API_KEY=your_gemini_api_key

# ── (Legacy) Shopify — not required if using Supabase products ──
# VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# VITE_SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token
# SHOPIFY_ADMIN_API_TOKEN=your_admin_api_token
