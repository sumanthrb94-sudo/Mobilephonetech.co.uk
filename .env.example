# ── Firebase (client) ──────────────────────────────────────────
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup
# These are public by design: access is controlled by the security rules in
# firestore.rules and storage.rules, not by hiding these values.
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef

# ── Firebase (server) ──────────────────────────────────────────
# Service-account JSON, raw or base64-encoded. Base64 is safer to paste into
# Vercel, whose env editor mangles multi-line values.
# Firebase console -> Project settings -> Service accounts -> Generate new private key
# NEVER prefix this with VITE_ — that would inline the private key into the browser bundle.
FIREBASE_SERVICE_ACCOUNT=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiwi...

# ── AI Tech Advisor ────────────────────────────────────────────
# Server-side only, never use VITE_ prefix
GEMINI_API_KEY=your_gemini_api_key

# ── (Legacy) Shopify — not required if using Supabase products ──
# VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# VITE_SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token
# SHOPIFY_ADMIN_API_TOKEN=your_admin_api_token

# ── Transactional email (Brevo REST API) ───────────────────────
# Used by api/_email.ts for welcome, order confirmation, dispatch and returns.
# Brevo -> SMTP & API -> API keys. Server-side only, never VITE_.
# With BREVO_API_KEY unset every send is a logged no-op rather than an error,
# so a missing key never fails a customer's order or return.
# Which provider sends. Optional — inferred from whichever key is set below,
# so adding RESEND_API_KEY is enough to switch. Explicit wins when both exist.
EMAIL_PROVIDER=
BREVO_API_KEY=
# Resend → API Keys. Starts "re_".
RESEND_API_KEY=
# ── Which lehart.co.uk mailbox does what ───────────────────────
# Eight exist on the IONOS plan: accounts@, aimen@, asim@, haroon@, info@,
# mir@, sales@, sourcing@. Only the two below are wired to the site; the rest
# are people's inboxes and internal functions, and nothing here should send as
# them or publish them.
#
# There is no orders@. Create one if the plan has a free slot — a dedicated
# transactional sender keeps receipts out of a shared inbox and makes a
# deliverability problem easy to isolate. Until then info@ does both jobs.
#
# EMAIL_FROM must be at a domain authenticated in Brevo. A free-mail address
# (gmail.com and the rest) cannot be DKIM/SPF-aligned for a Brevo relay, so
# every message is accepted and then junked by the recipient. /api/health warns
# when this is set to one.
EMAIL_FROM=info@lehart.co.uk
EMAIL_FROM_NAME=LeHart
# Where a customer's reply lands. Must be a mailbox somebody actually reads:
# people reply to receipts to ask where a parcel is or to report a fault, and
# a reply nobody sees is a complaint that becomes a chargeback.
EMAIL_REPLY_TO=info@lehart.co.uk

# Absolute site URL used for links inside emails. Defaults to https://lehart.co.uk
PUBLIC_SITE_URL=https://lehart.co.uk

# ── Campaigns (Listmonk) ───────────────────────────────────────
# Self-hosted, see deploy/listmonk/ and docs/EMAIL.md. Sync from
# api/_routes/newsletter.ts is best-effort: with any of these unset it is a
# logged no-op, and scripts/listmonk-sync.mjs reconciles later.
# NOTE: Listmonk's own SMTP credentials are Brevo's *SMTP* login and key,
# which are NOT the same as BREVO_API_KEY above. They live in
# deploy/listmonk/.env, not here.
LISTMONK_URL=
LISTMONK_USERNAME=
LISTMONK_TOKEN=
LISTMONK_LIST_ID=
# Only set for Listmonk v3 and older, which used HTTP Basic instead of tokens.
# LISTMONK_AUTH=basic

# ── Brevo contacts, webhooks, SMS ──────────────────────────────
# Contacts list for campaigns/automations. Brevo -> Contacts -> Lists.
BREVO_LIST_ID=

# Shared secret for the delivery-event webhook. Brevo does not sign its
# webhooks, so this query-string secret is the whole authentication. Generate
# with: openssl rand -hex 32
# Configure the URL in Brevo as:
#   https://lehart.co.uk/api/brevo-webhook?secret=<this value>
# With it unset the route 404s — closed by default, because an open webhook
# that suppresses addresses is a denial of service against your own customers.
BREVO_WEBHOOK_SECRET=

# Transactional SMS sender id, max 11 alphanumeric chars. SMS costs Brevo
# credits (it is NOT part of the free email tier), so with this unset every
# send is a logged no-op.
SMS_SENDER=

# ── Abandoned cart recovery ────────────────────────────────────
# Vercel sets CRON_SECRET automatically for cron invocations; set the same
# value here so the route can verify them. Without it the route refuses all.
CRON_SECRET=
# Hours to wait before the reminder, and after which it is too late to send.
ABANDONED_CART_DELAY_HOURS=4
ABANDONED_CART_CUTOFF_HOURS=48
# Ceiling per hourly run, well under Brevo's 300/day so a backlog can never
# exhaust the quota that order confirmations depend on.
ABANDONED_CART_MAX_PER_RUN=25

# ── Staff accounts ─────────────────────────────────────────────
# Comma-separated addresses promoted to admin by /api/bootstrap-admin. These
# are the people who sign in to /admin, so they must be addresses those people
# actually use — a custom claim only reaches the browser on a fresh sign-in.
# From the lehart.co.uk mailboxes: asim@, haroon@, mir@, aimen@ as needed.
ADMIN_EMAILS=

# ── Preview mode ───────────────────────────────────────────────
# The site is visible but must not take an order. One variable drives both the
# banner and the refusal: Vite inlines it into the bundle, and Vercel also
# hands it to the serverless functions, so they cannot disagree.
#
# Unset or "off"/"false"/"0"/"no" = the shop trades normally. Anything else
# set = preview. A typo counts as ON, because failing towards refusing orders
# is the cheap mistake and failing towards taking them is a real order with no
# payment behind it.
#
# The banner is a courtesy; api/_routes/orders.ts is the control. Changing this
# needs a redeploy — Vite inlines it at build time.
VITE_PREVIEW_MODE=on

# ── PayPal — the only payment gateway ──────────────────────────
# Nothing else takes money on this site. With no client id the checkout shows
# "checkout is temporarily unavailable" and refuses the order rather than
# offering a button that appears to work, so these are not optional in
# production.
#
# From the PayPal Developer dashboard → Apps & Credentials → your app. Use the
# copy icon: the dashboard truncates both values on screen, and a truncated
# client id makes the SDK fail to load with no useful error. A real client id
# is roughly 80 characters.
#
# VITE_PAYPAL_CLIENT_ID is inlined into the browser bundle by Vite, which is
# correct — the client id is public and ships in the tag on every site that
# uses PayPal. On Vercel it must therefore be a plain (non-sensitive) variable;
# marking a VITE_ value "sensitive"/"secret" is a contradiction.
#
# PAYPAL_SECRET is the opposite: server only, never prefixed with VITE_, and
# it must never appear in the bundle.
VITE_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# sandbox (default) or live. Also drives the "no real money moves" banner on
# the checkout: it shows unless VITE_PAYPAL_ENV is exactly "live", so the
# warning can only be removed by declaring the environment live on purpose.
PAYPAL_ENV=sandbox
VITE_PAYPAL_ENV=sandbox

# ── Unpaid orders ──────────────────────────────────────────────
# /api/orders writes a confirmed order and reserves stock WITHOUT taking any
# payment, and does not require a signed-in caller. It is the leftover of a
# card gateway that never landed. Leave this unset in production: setting it
# to "true" lets anyone who finds the endpoint order for free.
ALLOW_UNPAID_ORDERS=

# ── Microsoft Clarity ──────────────────────────────────────────
# Session replay and heatmaps. Loads only after the visitor accepts cookies;
# with no id set, nothing loads at all. Settings → Overview in Clarity.
VITE_CLARITY_PROJECT_ID=
