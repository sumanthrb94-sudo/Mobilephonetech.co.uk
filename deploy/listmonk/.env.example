# Copy to deploy/listmonk/.env and fill in. Never commit the real file.

# Postgres password for the listmonk role. Any long random string:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# First-run Listmonk admin login. Change the password in the UI after logging
# in once; this only exists so the first login does not need a shell.
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=

# Brevo SMTP relay credentials — NOT the v3 REST API key that BREVO_API_KEY
# holds. Brevo dashboard → SMTP & API → SMTP tab.
#   BREVO_SMTP_USER      looks like 8a1b2c001@smtp-brevo.com
#   BREVO_SMTP_PASSWORD  an SMTP key generated on that same tab
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
