rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// LeHart — Cloud Storage security rules
//
// Product imagery is public to read (it is on the shop front) and writable
// only by an admin. The size and content-type limits are enforced here rather
// than only in the upload form, because the form is client code and a
// determined caller can skip it.
//
// Deploy:  firebase deploy --only storage
// ═══════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
    }

    function withinSizeLimit() {
      return request.resource.size <= 5 * 1024 * 1024;
    }

    match /product-images/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isImage() && withinSizeLimit();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
